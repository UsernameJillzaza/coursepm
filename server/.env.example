# Copy to `.env` and fill in real values. `.env` is gitignored; this template is committed.
# PostgreSQL connection used by the app and by Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/coursepm?schema=public"
# Separate database used only by the automated tests. It MUST differ from DATABASE_URL:
# test setup refuses to run otherwise (AC-R01-2), then migrates only this database.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/coursepm_test?schema=public"
PORT=3000
NODE_ENV=development
# Optional PostgreSQL pool cap. Cloud Run's small Cloud SQL instance uses 3.
# DB_POOL_MAX=3
# Built React files for production; defaults to client/dist beside server/.
# CLIENT_DIST_DIR=/app/client/dist
# Session lifetime in hours (NFR-04, AC-01-11). Default 8.
SESSION_TTL_HOURS=8
# Password for the demo accounts, used by the seed.
# Choose your own locally; never commit it. Tests fall back to a known test
# password when it is not set.
SEED_PASSWORD=choose-a-local-demo-password
