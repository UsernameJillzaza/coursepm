// CoursePM data model — docs/system-sds.md §2. Each feature adds its tables
// through its own migration (F-01 users/sessions, F-03 teams, …).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// F-01 / BR-01: exactly one role per account. F-09 (Sprint 2) adds ADMIN,
// the Course Administrator, who manages teams and accounts but never sees
// team work (teamScopeWhere matches no team for an ADMIN).
enum Role {
  STUDENT
  SUPERVISOR
  ADMIN
}

model User {
  id                Int                    @id @default(autoincrement())
  email             String                 @unique // stored trimmed + lowercase
  name              String
  role              Role
  passwordHash      String // scrypt$N$r$p$salt$key (NFR-03)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  sessions          Session[]
  memberships       TeamMember[]
  supervising       SupervisorAssignment[]
  milestonesCreated Milestone[]          @relation("MilestoneCreatedBy")
  milestonesClosed  Milestone[]          @relation("MilestoneClosedBy")
  milestoneChanges  MilestoneChange[]
  extensionsGranted DeadlineExtension[]
  submissions       Submission[]
  feedbackGiven     Feedback[]
  scoresReleased    MilestoneScore[]       @relation("ScoreReleasedBy")
  scoreChanges      ScoreChange[]          @relation("ScoreChangedBy")
}

// NFR-04: the id is SHA-256(cookie token); the token itself is never stored.
model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// F-03 teams and membership (SDS §2). D-07: a student may be in several teams.
model Team {
  id          Int                    @id @default(autoincrement())
  name        String
  courseCode  String
  createdAt   DateTime               @default(now())
  members     TeamMember[]
  supervisors SupervisorAssignment[]
  milestones  Milestone[]
  submissions Submission[]

  @@unique([courseCode, name])
}

model TeamMember {
  teamId Int
  userId Int
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model SupervisorAssignment {
  teamId Int
  userId Int
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

// F-04 milestones. F-05 adds submissions and uses (id, teamId) as a
// composite target so a submission's team always matches its milestone.
model Milestone {
  id           Int          @id @default(autoincrement())
  teamId       Int
  team         Team         @relation(fields: [teamId], references: [id])
  title        String
  description  String
  deadline     DateTime     @db.Timestamptz(3)
  maxRevisions Int          @default(3)
  createdById  Int
  createdBy    User         @relation("MilestoneCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  // F-08: closed early by an assigned supervisor. CHECK: both null or both set.
  closedAt     DateTime?    @db.Timestamptz(3)
  closedById   Int?
  closedBy     User?        @relation("MilestoneClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  submissions  Submission[]
  changes      MilestoneChange[]
  extensions   DeadlineExtension[]
  score        MilestoneScore?

  @@unique([id, teamId])
  @@index([teamId, deadline])
}

// F-05 submissions (SDS §2, BR-07, NFR-05). Rows are never updated or
// deleted; UNIQUE(milestoneId, revision) stops two concurrent submissions
// from both becoming the same revision. teamId is copied from the milestone so
// scope checks are a single join.
model Submission {
  id            Int       @id @default(autoincrement())
  milestoneId   Int
  // Composite FK: the submission's team must be its milestone's team, so
  // authorization can never use a different team (F-05 data contract).
  milestone     Milestone @relation(fields: [milestoneId, teamId], references: [id, teamId])
  teamId        Int
  team          Team      @relation(fields: [teamId], references: [id])
  revision      Int
  title         String
  description   String    @default("")
  link          String
  submittedById Int
  submittedBy   User      @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime  @db.Timestamptz(3)
  feedback      Feedback?

  @@unique([milestoneId, revision])
  @@index([teamId])
}

// F-06: one feedback row belongs to exactly one submission revision.
model Feedback {
  id           Int        @id @default(autoincrement())
  submissionId Int        @unique
  submission   Submission @relation(fields: [submissionId], references: [id])
  supervisorId Int
  supervisor   User       @relation(fields: [supervisorId], references: [id])
  body         String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([supervisorId])
}

// F-08 (FR-12): audit of an edit (one row per changed field) or an early
// close. CHECKs in the migration tie field/values/reason to the kind. Rows are
// never updated or deleted by the app.
enum MilestoneChangeKind {
  EDIT
  CLOSE
}

model MilestoneChange {
  id          Int                 @id @default(autoincrement())
  milestoneId Int
  milestone   Milestone           @relation(fields: [milestoneId], references: [id])
  kind        MilestoneChangeKind
  field       String?
  oldValue    String?
  newValue    String?
  reason      String?
  changedById Int
  changedBy   User                @relation(fields: [changedById], references: [id])
  changedAt   DateTime            @db.Timestamptz(3)

  @@index([milestoneId, changedAt])
}

// F-08 (FR-13, BR-11): a deadline extension. CHECK newDeadline >
// previousDeadline enforces BR-11 in the database; Milestone.deadline holds
// the newest value. Rows are never updated or deleted by the app.
model DeadlineExtension {
  id               Int       @id @default(autoincrement())
  milestoneId      Int
  milestone        Milestone @relation(fields: [milestoneId], references: [id])
  previousDeadline DateTime  @db.Timestamptz(3)
  newDeadline      DateTime  @db.Timestamptz(3)
  reason           String
  grantedById      Int
  grantedBy        User      @relation(fields: [grantedById], references: [id])
  grantedAt        DateTime  @db.Timestamptz(3)

  @@index([milestoneId, grantedAt])
}

// F-11 (FR-16, BR-12, D-10): one score 0–100 per milestone, hidden from the
// team until released; a change after release needs a reason. CHECKs in the
// migration: score 0–100, the release pair, the ScoreChange kind rules, and
// BR-12 in the database (afterRelease ⇒ a SET with a 3–500 character reason).
enum ScoreChangeKind {
  SET
  RELEASE
}

model MilestoneScore {
  id           Int           @id @default(autoincrement())
  milestoneId  Int           @unique
  milestone    Milestone     @relation(fields: [milestoneId], references: [id])
  score        Int
  releasedAt   DateTime?     @db.Timestamptz(3)
  releasedById Int?
  releasedBy   User?         @relation("ScoreReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @db.Timestamptz(3)
  updatedAt    DateTime      @db.Timestamptz(3)
  changes      ScoreChange[]
}

// Every value, release and reason the score ever had. Rows are never updated
// or deleted by the app.
model ScoreChange {
  id               Int             @id @default(autoincrement())
  milestoneScoreId Int
  milestoneScore   MilestoneScore  @relation(fields: [milestoneScoreId], references: [id])
  kind             ScoreChangeKind
  oldScore         Int?
  newScore         Int?
  reason           String?
  afterRelease     Boolean         @default(false)
  changedById      Int
  changedBy        User            @relation("ScoreChangedBy", fields: [changedById], references: [id])
  changedAt        DateTime        @db.Timestamptz(3)

  @@index([milestoneScoreId, changedAt])
}
