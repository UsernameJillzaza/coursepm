# CoursePM — environment template for `docker compose up` (Lab 5, C-03).
# Copy to `.env` (git-ignored) and replace every placeholder. Commit only this
# template, never `.env`. Local development without Docker uses
# `server/.env.example` instead.

# --- PostgreSQL container (docker-compose `db`) ---
# Compose builds DATABASE_URL from these three, so use URL-safe characters
# (letters, digits, - and _) in the password.
POSTGRES_USER=coursepm
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=coursepm

# --- Seed (docker-compose `migrate`) ---
# Password given to every seeded demo account. Required: the seed refuses to
# run without it. Share it with testers privately; never show it on screen.
SEED_PASSWORD=change-me-demo-password

# --- App (docker-compose `app`) ---
# Session lifetime in hours (default 8).
SESSION_TTL_HOURS=8
# Host port to open the app on: http://localhost:${APP_PORT}
APP_PORT=3000

# Variables the server reads that Compose sets for you (do not put them here):
#   DATABASE_URL  built from the POSTGRES_* values above; on GCP from Secret Manager
#   NODE_ENV      `production`, set in the Dockerfile
#   PORT          `3000`, set in the Dockerfile; Cloud Run injects its own
